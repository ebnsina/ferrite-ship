# Control-plane configuration. Copy to `.env` and fill in.
#
# Every variable is required and validated at boot. There are no defaults for
# anything that decides where data goes or how credentials are protected — a
# misconfigured deploy should fail loudly, not run against the wrong database.

# Listen address. Bound to loopback: this API holds root credentials for every
# connected server, so it must not be reachable from the network until there is
# authentication in front of it.
FERRITE_ADDR=127.0.0.1:8080

# SQLite database file. Created on first run.
FERRITE_DATABASE_PATH=./data/ferrite.db

# Base64 of 32 random bytes, used to encrypt stored SSH credentials.
# Generate one with:  go run ./cmd/ferrite-ship genkey
# Losing this key means every stored credential becomes unreadable.
FERRITE_SECRET_KEY=

# Origin allowed to call the API cross-site. Set this to the Vite dev server
# while developing. Use the literal "none" in production, where this same
# process serves the dashboard and no cross-origin request should be allowed.
# Required: unset is an error, never a silent "no".
FERRITE_ALLOWED_ORIGIN=http://localhost:5173

# Built dashboard to serve (web/build), or the literal "none" to run API-only,
# which is what you want while Vite serves the UI.
# Required: unset is an error, never a silent "no".
FERRITE_WEB_DIR=none

# Where this dashboard is reachable from a browser. Used only to put a link in
# an alert email, so a wrong value is a broken link rather than a broken app.
# Set "none" to send alerts without one.
FERRITE_PUBLIC_URL=http://localhost:5173

# Where to hand outgoing mail. Without it nothing is sent, and the settings
# page says so rather than pretending an address was saved.
#   smtp://user:password@host:587   STARTTLS, required — a password is sent
#   smtps://user:password@host:465  TLS from the first byte
# Set "none" to send no mail at all.
FERRITE_SMTP_URL=none

# The address alerts are sent from. Required whenever a mail server is set,
# because a server that rejects the sender does so at the worst moment.
FERRITE_MAIL_FROM=

# GitHub App, for deploying from private repositories without pasting a deploy
# key. A GitHub App rather than an OAuth app: it is installed on the
# repositories you choose, its tokens expire in an hour, and you can revoke it
# from GitHub's own settings without asking us.
#
# All four are required together, or set the id to "none" to deploy only from
# a pasted git URL — which is how every existing installation already works.
#   FERRITE_GITHUB_APP_ID          the numeric id on the app's settings page
#   FERRITE_GITHUB_APP_SLUG        the name in the app's URL
#   FERRITE_GITHUB_PRIVATE_KEY     base64 < your-app.private-key.pem
#   FERRITE_GITHUB_WEBHOOK_SECRET  without it, anybody could ask for a deploy
FERRITE_GITHUB_APP_ID=none
FERRITE_GITHUB_APP_SLUG=
FERRITE_GITHUB_PRIVATE_KEY=
FERRITE_GITHUB_WEBHOOK_SECRET=
