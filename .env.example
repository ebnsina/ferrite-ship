# Control-plane configuration. Copy to `.env` and fill in.
#
# Every variable is required and validated at boot. There are no defaults for
# anything that decides where data goes or how credentials are protected — a
# misconfigured deploy should fail loudly, not run against the wrong database.

# Listen address.
FERRITE_ADDR=:8080

# SQLite database file. Created on first run.
FERRITE_DATABASE_PATH=./data/ferrite.db

# Base64 of 32 random bytes, used to encrypt stored SSH credentials.
# Generate one with:  go run ./cmd/ferrite-ship genkey
# Losing this key means every stored credential becomes unreadable.
FERRITE_SECRET_KEY=

# Origin allowed to call the API cross-site. Set this to the Vite dev server
# while developing. Use the literal "none" in production, where this same
# process serves the dashboard and no cross-origin request should be allowed.
# Required: unset is an error, never a silent "no".
FERRITE_ALLOWED_ORIGIN=http://localhost:5173

# Built dashboard to serve (web/build), or the literal "none" to run API-only,
# which is what you want while Vite serves the UI.
# Required: unset is an error, never a silent "no".
FERRITE_WEB_DIR=none
