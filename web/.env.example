# Copy to `.env` and fill in. Every variable here is REQUIRED.
# The app throws on boot if any is missing — there are no defaults and no
# fallbacks by design, so a misconfigured deploy fails loudly instead of
# silently pointing at the wrong backend.

# Base URL of the ferrite-ship Go control-plane API. No trailing slash.
PUBLIC_API_BASE_URL=http://localhost:8080

# Deployment environment. One of: development | staging | production
PUBLIC_APP_ENV=development

# Public-facing origin of this web app. Used for canonical URLs and metadata.
PUBLIC_APP_URL=http://localhost:5173

# Where the dashboard reads its data from. One of: api | mock
# `mock` runs the UI against in-memory fixtures with no control plane running.
PUBLIC_DATA_SOURCE=mock
